# Local setup copies this template to frontend/.dev.vars. All values are optional for sample mode.
# Put server-side credentials in frontend/.dev.vars, never in client code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=
CMO_OWNER_USER_ID=
AUTOMATION_SECRET=

# Optional team roles, keyed by authenticated user ID. Server-only.
CMO_TEAM_MEMBERS=
# Google Calendar (OAuth token also needs calendar event scopes)
GOOGLE_CALENDAR_ID=
# LinkedIn supported Posts API version (YYYYMM) and author URN
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=
# Instagram with Facebook Login; supported Graph API version (vNN.N)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=
# Structured AI planning
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Source-backed public search
BRAVE_SEARCH_API_KEY=

# Set to sites ONLY when deployed behind the trusted Sites authentication gateway.
# Leave blank for standalone/local builds; local dev uses a development identity.
GOSAKHA_AUTH_PROVIDER=
